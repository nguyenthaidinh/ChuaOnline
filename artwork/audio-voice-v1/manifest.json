  "entries": [
    {
      "id": "b01",
      "kind": "blessing",
      "text": "Nguyện một ngày bình an. Chúc bạn thân tâm an lạc, tìm thấy một khoảng bình yên giữa những bộn bề.",
      "file": "public/assets/audio/blessings/b01.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b01.wav",
      "sha256": "4b8a00eb3d23cb4b21e1694efbebb88da31b604d3e60a3db5d270abcc61cbdc7",
      "masterSha256": "d37780665243456c65df2994cb215f23574f26949ad69ce95d2818eb5420f95f",
      "bytes": 44205,
      "durationSeconds": 5.436,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b02",
      "kind": "blessing",
      "text": "Bình an trong mái nhà. Mong bạn và gia đình luôn mạnh khỏe, biết lắng nghe và dành cho nhau những lời dịu dàng.",
      "file": "public/assets/audio/blessings/b02.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b02.wav",
      "sha256": "b66a90fa53658376e1133702c408e99e20562e753ab0c13d017102bd36481a0c",
      "masterSha256": "e4d296f399d03581d96f8195cd2edd7bfb4d774f58df504e88d88c31a84afa01",
      "bytes": 54765,
      "durationSeconds": 6.75,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b03",
      "kind": "blessing",
      "text": "Vững bước mỗi ngày. Mong mỗi bước chân của bạn đều có sự vững vàng, sáng suốt và lòng thiện lành.",
      "file": "public/assets/audio/blessings/b03.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b03.wav",
      "sha256": "de2ba864a424ebe2021930a2d9b70fdfa2a03ec16f13c36d1240a55427cfbbde",
      "masterSha256": "9bdbb18c99968e5f822db43b36f196e056a0275ca8f60fcdde87101c078fac1f",
      "bytes": 48813,
      "durationSeconds": 6.023,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b04",
      "kind": "blessing",
      "text": "Một hơi thở nhẹ nhàng. Nguyện những lo âu hôm nay nhẹ dần theo từng hơi thở, nhường chỗ cho sự bình yên.",
      "file": "public/assets/audio/blessings/b04.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b04.wav",
      "sha256": "37ac9cf0f73e15fa3f7f86aa7ce151499e386b3ec729c89addaffa0c79df4a6b",
      "masterSha256": "0b7cdf7b7e5544ad438e068ad3bbac16a7b04432dcf7caf74e651df2bccd4d48",
      "bytes": 52845,
      "durationSeconds": 6.506,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b05",
      "kind": "blessing",
      "text": "An vui từ điều giản dị. Chúc bạn tìm thấy niềm vui trong một bữa cơm ấm, một lời hỏi thăm và những điều bình thường quanh mình.",
      "file": "public/assets/audio/blessings/b05.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b05.wav",
      "sha256": "5e9c7b8de9190360f7b97684c54298fb6833841a7901a945cb261ea432400536",
      "masterSha256": "02e60af43dfee339d0f3b783c24600bdbc3c09786f2ec54b49e7d2dd8c920d6e",
      "bytes": 59181,
      "durationSeconds": 7.311,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b06",
      "kind": "blessing",
      "text": "Thân khỏe, tâm nhẹ. Mong bạn có một giấc ngủ an lành, biết nghỉ khi mệt và chăm sóc bản thân bằng lòng kiên nhẫn.",
      "file": "public/assets/audio/blessings/b06.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b06.wav",
      "sha256": "98c87f2b501991459e7b16d70d40e905db8c1cc9eb48f07ab9d2e04c91ab8372",
      "masterSha256": "797b238d5b8635ccc19525e99f62f11eaf1df076f56ec51d012b23643c8dccf9",
      "bytes": 56301,
      "durationSeconds": 6.956,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b07",
      "kind": "blessing",
      "text": "Gửi nhau một tâm lành. Nguyện lời bạn nói hôm nay đem lại sự ấm áp, và một việc tốt nhỏ trở thành niềm vui cho ai đó.",
      "file": "public/assets/audio/blessings/b07.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b07.wav",
      "sha256": "0ac8b0b862e7fb6bf5998ee1f752443e816218a2b1b1b825e169ff3e2875dd5a",
      "masterSha256": "ad4e5e4670bb870368bf5e8d278c72d4d71e75dc2fab17fe44accc9684b3853a",
      "bytes": 61101,
      "durationSeconds": 7.539,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b08",
      "kind": "blessing",
      "text": "Để lòng được thảnh thơi. Chúc bạn đặt xuống một điều tự trách, bớt đi một nỗi lo và dịu dàng hơn với chính mình.",
      "file": "public/assets/audio/blessings/b08.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b08.wav",
      "sha256": "43cd49e61bea5f4a97a896b688372812cbd9c997f68c5f79ce8955ddd3cd5910",
      "masterSha256": "8dbc1177e27131ec4899b41e28942c2fbe3c8ba3771a5f3cfba7c89eb08ca5bc",
      "bytes": 54189,
      "durationSeconds": 6.678,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b09",
      "kind": "blessing",
      "text": "Biết ơn ngày đang có. Mong bạn nhận ra những bàn tay vẫn âm thầm nâng đỡ mình và kịp gửi đến họ một lời cảm ơn.",
      "file": "public/assets/audio/blessings/b09.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b09.wav",
      "sha256": "7f8a86c18ac639a746e4c599974bdf015983f7152fac3d73a228354640acce23",
      "masterSha256": "d10c15ae2597efc19e9b2b4e0c263770ae58879fcd97df390d72d36ff06471e0",
      "bytes": 54957,
      "durationSeconds": 6.776,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b10",
      "kind": "blessing",
      "text": "Bình tâm trước đổi thay. Nguyện giữa những đổi thay, bạn vẫn giữ được điều hiền lành trong tim và đủ bình tĩnh cho bước tiếp theo.",
      "file": "public/assets/audio/blessings/b10.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b10.wav",
      "sha256": "0c3cc9e21d375c27c41af85e6f22272c8cd4fd611b55afa66b0b6295e43f8203",
      "masterSha256": "117033ceb95b5f55ddc3284496eb68fcd36579036f67644d4a1e1c96acb05088",
      "bytes": 56301,
      "durationSeconds": 6.952,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b11",
      "kind": "blessing",
      "text": "Một mái nhà ấm áp. Chúc mái nhà của bạn có thêm tiếng cười, những bữa cơm sum họp và sự quan tâm chân thành.",
      "file": "public/assets/audio/blessings/b11.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b11.wav",
      "sha256": "979e55a4166a8ff33ba669953c64e29fa73d2c0c22a25b97e2e7392b7acb75d3",
      "masterSha256": "99e833108ea771b964871dfa134f09bad34c993212b4983e30d89fc70fc0c654",
      "bytes": 54957,
      "durationSeconds": 6.783,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b12",
      "kind": "blessing",
      "text": "An lành cho cha mẹ. Mong cha mẹ và những người thân yêu của bạn có những ngày khỏe mạnh, thanh thản và được yêu thương.",
      "file": "public/assets/audio/blessings/b12.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b12.wav",
      "sha256": "5b09c3fc6888cefc6d5fd41a461e39f93f651fabffecd6c63a35be346ca59d54",
      "masterSha256": "bb2fd85438a3cca1ad237e985a28b32534b228b596b4d76538826d93e3c4324b",
      "bytes": 55341,
      "durationSeconds": 6.818,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b13",
      "kind": "blessing",
      "text": "Kiên nhẫn với hành trình. Chúc những nỗ lực của bạn dần đơm hoa. Mỗi bước nhỏ đều đáng quý, hãy cho mình thời gian.",
      "file": "public/assets/audio/blessings/b13.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b13.wav",
      "sha256": "7b39975bc3bf0fba774a457dfe1f84a273fd8bc744ac358a1760a21b93bdb133",
      "masterSha256": "2a37e436e8c30f29932c8bfb61c0f1f42f0ce017cf8cd1513e67ef34618eff13",
      "bytes": 60141,
      "durationSeconds": 7.436,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b14",
      "kind": "blessing",
      "text": "Nhẹ lòng sau một ngày. Nguyện sau một ngày khó khăn, bạn vẫn tìm được một điều nhỏ để mỉm cười và một khoảng yên để nghỉ.",
      "file": "public/assets/audio/blessings/b14.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b14.wav",
      "sha256": "d026107e44571fd9b6e029ba43510ae792a05dbf3c99f7715d6ce09b5d4f32c2",
      "masterSha256": "744f9c3431d718d65518129abba433ecb304eb52e18e2c7ad99b98d832351389",
      "bytes": 59373,
      "durationSeconds": 7.324,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b15",
      "kind": "blessing",
      "text": "Gặp gỡ trong tử tế. Mong bạn gặp những người biết lắng nghe và cũng có dịp ở bên một người đang cần được sẻ chia.",
      "file": "public/assets/audio/blessings/b15.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b15.wav",
      "sha256": "fdaac257f1241f6550dbf0fed03c721629dd4cd74d69a76f9bbd76abe47ec062",
      "masterSha256": "135179201abed4bee8f785cc098037bae9251186670138c1bb6a290b6d25a159",
      "bytes": 54573,
      "durationSeconds": 6.739,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b16",
      "kind": "blessing",
      "text": "Đủ đầy trong hiện tại. Chúc bạn biết trân trọng điều đang có, sống chậm lại một chút và nhận ra vẻ đẹp của ngày hôm nay.",
      "file": "public/assets/audio/blessings/b16.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b16.wav",
      "sha256": "8b4fe66c16dccdafcfd305e87544e3dcd944e8467b243935e5fb260c3716895c",
      "masterSha256": "a0814224fc989cea08326bcd8e3d2edde00abf997d0a10a84acea974a14402e1",
      "bytes": 58029,
      "durationSeconds": 7.164,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b17",
      "kind": "blessing",
      "text": "An yên trên đường xa. Mong người đang đi xa được vững tâm, biết giữ mình và có một nơi ấm áp để trở về.",
      "file": "public/assets/audio/blessings/b17.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b17.wav",
      "sha256": "6692ae5abcbee57e2a061c23dff2fb2d1f8f7a6506cdab8e62e9ed2e9cfbd593",
      "masterSha256": "f61777f70842e17c1b07cf62ba65b095b81dea5a1c276fce81a9c9955af7ccc9",
      "bytes": 53805,
      "durationSeconds": 6.632,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b18",
      "kind": "blessing",
      "text": "Can đảm để bắt đầu. Nguyện bạn đủ can đảm để bắt đầu, đủ bền lòng để tiếp tục và đủ sáng suốt để nghỉ ngơi khi cần.",
      "file": "public/assets/audio/blessings/b18.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b18.wav",
      "sha256": "1ff6d49fd3ed47f9fa63d330b45343287edd1eb7357e73ab2e191307904054f1",
      "masterSha256": "b34e26a8ad8a21a062f879d2b0cbf0b39951f20cd5c11d0854e6082a6aed64e0",
      "bytes": 61101,
      "durationSeconds": 7.55,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b19",
      "kind": "blessing",
      "text": "Lòng rộng, tâm an. Chúc bạn có đủ bình tĩnh trước một lời khó nghe, đủ rộng lòng trước khác biệt và biết giữ gìn sự an yên.",
      "file": "public/assets/audio/blessings/b19.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b19.wav",
      "sha256": "18407094baba8cb379587a327db8e9321716f7edee6774c9000a88298977aa21",
      "masterSha256": "ac7d1064829edfc6ad933e7abfc4007b65e125b1bd6cb29015ce14bada5b9a89",
      "bytes": 62253,
      "durationSeconds": 7.694,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "b20",
      "kind": "blessing",
      "text": "Mang bình an về nhà. Mong bạn rời chánh điện với một hơi thở nhẹ hơn, mang theo lòng biết ơn và một tâm lành vào cuộc sống.",
      "file": "public/assets/audio/blessings/b20.mp3",
      "master": "artwork/audio-voice-v1/masters/blessing-b20.wav",
      "sha256": "0ed7cb4903ec7d89e05d72b782e6fea80f6041228b372f65a1b44bbb0a2e6926",
      "masterSha256": "ff008af67f1b6bc536886324d34f89fcf44f2e83c3782a109ed113a410826da4",
      "bytes": 60141,
      "durationSeconds": 7.439,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "incense",
      "kind": "ritual",
      "text": "Nguyện hương lành lan tỏa. Chúc bạn và gia đình luôn bình an.",
      "file": "public/assets/audio/rituals/incense.mp3",
      "master": "artwork/audio-voice-v1/masters/ritual-incense.wav",
      "sha256": "ab04ac6eb50f86d094871ec5dae8fd894550ac4d363dec5afb8de8e6c8b8b361",
      "masterSha256": "5f4c47408c334138af19796c0e9604acc61440a1c5afc5e641259540a37935f3",
      "bytes": 29229,
      "durationSeconds": 3.575,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "lotus",
      "kind": "ritual",
      "text": "Nguyện tâm trong như hoa sen. Chúc bạn an vui mỗi ngày.",
      "file": "public/assets/audio/rituals/lotus.mp3",
      "master": "artwork/audio-voice-v1/masters/ritual-lotus.wav",
      "sha256": "5ea4f2c775ea7a4f99d1789ffa5ae66e22e3ea0390c588c0bfdece7a5b39386d",
      "masterSha256": "f8d13c7a764816e7f7adab88764ed2825a79e2435e37afe0d5c4004671f53534",
      "bytes": 27885,
      "durationSeconds": 3.406,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "petal",
      "kind": "ritual",
      "text": "Gửi một tâm lành. Nguyện những điều tốt đẹp đến với bạn.",
      "file": "public/assets/audio/rituals/petal.mp3",
      "master": "artwork/audio-voice-v1/masters/ritual-petal.wav",
      "sha256": "214f6dfc3c0b800fbfde4f148a85ec2cb4b7ded802355fb7946f34eaff609ef6",
      "masterSha256": "7681af4fb9f2b77e10bdd489b95e025f53f9b3a31f7f4b3ea672e3aff213429b",
      "bytes": 27309,
      "durationSeconds": 3.32,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "bell",
      "kind": "ritual",
      "text": "Tiếng chuông nhắc mình trở về. Nguyện thân tâm an lạc.",
      "file": "public/assets/audio/rituals/bell.mp3",
      "master": "artwork/audio-voice-v1/masters/ritual-bell.wav",
      "sha256": "3ceb896d0084f6c24efa1fccae86308c44899c9e3ba41e7d2245f28e96e37e26",
      "masterSha256": "a4184a87f23e13d45249b7c3547e34afbb5c60849f27f5be9cc441b3fb82ce5c",
      "bytes": 25197,
      "durationSeconds": 3.058,
      "codec": "mp3",
      "sampleRate": 24000,
      "channels": 1
    },
    {
      "id": "bow",
      "kind": "ritual",
      "text": "Nguyện thân tâm an lạc. Chúc bạn giữ được sự bình an trong mỗi bước chân.",
      "file": "public/assets/audio/rituals/bow.mp3",
      "master": "artwork/audio-voice-v1/masters/ritual-bow.wav",
      "sha256": "ea3f0973feb42f385bc681d6b27890629d1fabc87143e1e755e07e50816a9ac0",
      "masterSha256": "6cb676dc2146e4daa8980a0af5183a172b04b829b047fd4347ef8da2b82508ac",
